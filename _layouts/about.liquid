---
layout: default
---
<div class="about-page">
  {% if page.hero %}
    <header class="about-hero">
      {% if page.hero.image %}
        <img
          src="{{ page.hero.image | prepend: 'assets/img/' | relative_url }}"
          alt="{{ site.title }}"
          class="{% if page.hero.image_dark %}logo-light{% endif %}"
          loading="eager"
        >
        {% if page.hero.image_dark %}
          <img src="{{ page.hero.image_dark | prepend: 'assets/img/' | relative_url }}" alt="{{ site.title }}" class="logo-dark" loading="eager">
        {% endif %}
      {% endif %}
      {% if page.hero.tagline %}<p class="about-tagline">{{ page.hero.tagline }}</p>{% endif %}
    </header>
  {% endif %}

  <article class="about-main">
    <div class="clearfix">{{ content }}</div>

    <!-- Latest posts -->
    {% if page.latest_posts %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Events</a>
      </h2>
      {% include latest_posts.liquid %}
      <br>
    {% endif %}

    <!-- News -->
    {% if page.news %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid %}
      <div class="news-spacer"></div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
